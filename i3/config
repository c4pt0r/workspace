client.background       #2E3440

# Start i3bar to display a workspace bar (plus the system information i3status
# finds out, if available)
bar {
    status_command i3status
	colors {
		background #2E3440
		statusline #D8DEE9
		separator  #4C566A

		focused_workspace  #5E81AC #5E81AC #ECEFF4
		active_workspace   #434C5E #434C5E #D8DEE9
		inactive_workspace #2E3440 #2E3440 #7B88A1
		urgent_workspace   #BF616A #BF616A #ECEFF4
		binding_mode       #BF616A #BF616A #ECEFF4
	}
}

bindsym Mod1+Tab exec rofi -show window
#bindsym Mod1+Tab workspace back_and_forth
bindsym Mod1+Shift+Tab workspace prev

# display 
set $displayMode "Set display mode [l]aptop, [1] dp-only, [2] dp & laptop, [3] mirror"
bindsym $mod+x mode $displayMode
mode $displayMode {

    bindsym l exec --no-startup-id ~/.config/i3/laptop.sh, mode "default"
    bindsym 1 exec --no-startup-id ~/.config/i3/dp-only.sh, mode "default"
    bindsym 2 exec --no-startup-id ~/.config/i3/dp-extend.sh, mode "default"
    bindsym 3 exec --no-startup-id ~/.config/i3/mirror.sh, mode "default"

    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# power management
# set $Locker i3lock && sleep 1
set $Locker i3lock && sleep 1

set $mode_system System (l) lock, (e) logout, (s) suspend, (h) hibernate, (r) reboot, (Shift+s) shutdown
mode "$mode_system" {
    bindsym l exec --no-startup-id $Locker, mode "default"
    bindsym e exec --no-startup-id i3-msg exit, mode "default"
    bindsym s exec --no-startup-id $Locker && systemctl suspend, mode "default"
    bindsym h exec --no-startup-id $Locker && systemctl hibernate, mode "default"
    bindsym r exec --no-startup-id systemctl reboot, mode "default"
    bindsym Shift+s exec --no-startup-id systemctl poweroff -i, mode "default"  

    # back to normal: Enter or Escape
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

bindsym $mod+Delete mode "$mode_system"

# screenshot selection

bindsym --release XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym --release XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym --release XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym --release XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle


